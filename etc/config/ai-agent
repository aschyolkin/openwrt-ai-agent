config main 'main'
	option enable '1'
	option socket_path '/var/run/ai-agent.sock'
	option model_id 'gpt://b1gq9kr4q4sjlm3vradj/deepseek-v4-flash/latest'
	option model_routing_enabled '1'
	option simple_model_id 'gpt://b1gq9kr4q4sjlm3vradj/gpt-oss-20b/latest'
	option complex_model_id 'gpt://b1gq9kr4q4sjlm3vradj/deepseek-v4-flash/latest'
	option api_base_url 'https://ai.api.cloud.yandex.net/v1'
	option max_tool_loop_iterations '8'
	option confirm_ttl_seconds '300'
	option backup_retention_days '30'
	option log_level 'INFO'
	option state_dir '/var/lib/ai-agent'
	option secrets_path '/etc/ai-agent/secrets.env'
	option system_prompt_path '/etc/ai-agent/system_prompt.md'
	option request_timeout_seconds '60'
	option max_request_bytes '1048576'
	option command_output_limit '65536'
	option conversation_max_chars '12000'
	option tool_context_max_chars '16000'
	option log_monitor_interval_hours '4'
