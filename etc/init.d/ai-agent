#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

start_service() {
	local enabled socket_path
	config_load ai-agent
	config_get_bool enabled main enable 1
	[ "$enabled" -eq 1 ] || return 0
	config_get socket_path main socket_path /var/run/ai-agent.sock

	procd_open_instance
	procd_set_param command /usr/bin/python3 -m ai_agent
	procd_set_param env PYTHONPATH=/usr/lib/ai-agent PYTHONUNBUFFERED=1
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/ai-agent /etc/ai-agent/system_prompt.md /etc/ai-agent/secrets.env
	procd_set_param limits nofile=1024:1024
	procd_close_instance
}

stop_service() {
	local socket_path
	config_load ai-agent
	config_get socket_path main socket_path /var/run/ai-agent.sock
	[ -S "$socket_path" ] && rm -f "$socket_path"
}

sync_log_monitor_cron() {
	local hours CRON=/etc/crontabs/root
	[ -f "$CRON" ] || return 0
	config_load ai-agent
	config_get hours main log_monitor_interval_hours 4
	case "$hours" in ''|*[!0-9]*) hours=4 ;; esac
	[ "$hours" -ge 1 ] 2>/dev/null && [ "$hours" -le 24 ] 2>/dev/null || hours=4
	sed -i '/# ai-agent-log-monitor$/d' "$CRON"
	echo "23 */$hours * * * /usr/bin/ai-agent-log-monitor # ai-agent-log-monitor" >> "$CRON"
	/etc/init.d/cron restart >/dev/null 2>&1 || true
}

reload_service() {
	sync_log_monitor_cron
	restart
}

service_triggers() {
	procd_add_reload_trigger ai-agent
}

