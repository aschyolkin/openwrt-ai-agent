#!/bin/sh /etc/rc.common

START=96
STOP=9
USE_PROCD=1

start_service() {
	[ -r /etc/ai-agent/telegram.env ] || return 0
	procd_open_instance
	procd_set_param command /usr/bin/ai-agent-telegram
	procd_set_param env PYTHONPATH=/usr/lib/ai-agent PYTHONUNBUFFERED=1
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/ai-agent/telegram.env
	procd_set_param limits nofile=256:256
	procd_close_instance
}
